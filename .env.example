# Copy to .env (or run `uv run python scripts/init_env.py`, which generates random values).
GATEWAY_ADMIN_TOKEN=
CHAOS_ADMIN_TOKEN=
GRAFANA_ADMIN_PASSWORD=
# Provider secrets live in the shared portfolio env file (GROQ_API_KEY, HF_TOKEN, optional ANTHROPIC_API_KEY,
# LLM_SPEND_CAP_USD, LLM_SPEND_LEDGER). Path:
PORTFOLIO_ENV_FILE=F:/.secrets/portfolio.env
# Optional overrides
# REDIS_URL=redis://127.0.0.1:16380/0
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_CPU_URL=http://127.0.0.1:11435
# HF_ENABLED=1
# CHAOS_ENABLED=1
# CHAOS_PROXY_URL=http://127.0.0.1:8113
# PROJECT_SPEND_CAP_USD=1.0
# REQUEST_LOG_PATH=logs/requests.jsonl

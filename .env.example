# Copy to .env (or run `uv run python scripts/init_env.py`, which generates random values).
GATEWAY_ADMIN_TOKEN=
CHAOS_ADMIN_TOKEN=
GRAFANA_ADMIN_PASSWORD=
# Provider secrets live in the shared portfolio env file (GROQ_API_KEY, HF_TOKEN, optional ANTHROPIC_API_KEY,
# LLM_SPEND_CAP_USD, LLM_SPEND_LEDGER). Path:
PORTFOLIO_ENV_FILE=F:/.secrets/portfolio.env
# Optional overrides
# REDIS_URL=redis://127.0.0.1:16380/0
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_CPU_URL=http://127.0.0.1:11435
# HF_ENABLED=1
# CHAOS_ENABLED=1
# CHAOS_PROXY_URL=http://127.0.0.1:8113
# PROJECT_SPEND_CAP_USD=1.0
# REQUEST_LOG_PATH=logs/requests.jsonl
# Deployment settings (Cloud Run sets these from Terraform; values here are for local experiments only)
# ENV=dev                      # dev | test | staging | prod (prod refuses chaos, local providers, file ledger)
# GATEWAY_ROLE=all             # all | api | worker
# GATEWAY_CONFIG=config/gateway.yaml   # prod: config/gateway.prod.yaml (external providers only)
# SPEND_BACKEND=file           # file (shared local ledger) | redis (monthly cap shared by all instances)
# LLM_KILL_SWITCH=0            # 1 disables every provider call
# METRICS_PORT=                # set (e.g. 8080) to serve /metrics on 127.0.0.1 only, not on the API port
# TENANT_KEYS_JSON=            # {"tenant": {"rpm": 600, "key_sha256": ["<hex>"]}} (Secret Manager in GCP)
# REDIS_PASSWORD=              # Memorystore AUTH (Secret Manager in GCP)
# REDIS_CA_CERT_PEM=           # Memorystore server CA for rediss:// (not a secret)
